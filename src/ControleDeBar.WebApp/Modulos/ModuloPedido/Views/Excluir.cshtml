@using ControleDeBar.WebApp.Modulos.ModuloPedido

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Pedido";
}

@model ExcluirPedidoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4"
      style="max-width: 620px;"
      asp-action="Excluir"
      asp-route-id="@Model.Id"
      method="post">

    <input asp-for="Id" type="hidden">
    <input asp-for="ContaId" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3"
         role="alert">
        Deseja realmente excluir esse Pedido?
    </div>

    <dl class="row mb-0">

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            ID
        </dt>
        <dd class="col-sm-8 text-break">
            @Model.Id
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Produto
        </dt>
        <dd class="col-sm-8">
            @Model.NomeProduto
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Quantidade
        </dt>
        <dd class="col-sm-8">
            @Model.Quantidade
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Total
        </dt>
        <dd class="col-sm-8">
            @Model.Total.ToString("C")
        </dd>

    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a class="btn btn-outline-primary rounded-pill px-4"
           asp-action="Listar"
           asp-route-contaId="@Model.ContaId">
            Voltar
        </a>

        <button class="btn btn-primary rounded-pill px-4"
                type="submit">
            Confirmar
        </button>

    </div>

</form>