@using ControleDeBar.WebApp.Modulos.ModuloConta

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Contas";
}

@model List<ListarContaViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">
    Cadastrar Nova
</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhuma conta cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
        @foreach (ListarContaViewModel conta in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h5 class="card-title mb-1">
                                    @conta.NomeCliente
                                </h5>
                            </div>

                            <span class="badge text-bg-primary rounded-pill">
                                @conta.Id.ToString().Substring(0, 8)
                            </span>
                        </div>

                        <dl class="row g-2 mb-4">

                            <dt class="col-5 text-secondary fw-semibold">
                                Garçom
                            </dt>
                            <dd class="col-7 mb-0 text-break">
                                @conta.GarconNome
                            </dd>

                            <dt class="col-5 text-secondary fw-semibold">
                                Mesa
                            </dt>
                            <dd class="col-7 mb-0 text-break">
                                @conta.NumeroDaMesa
                            </dd>

                            <dt class="col-5 text-secondary fw-semibold">
                                Abertura
                            </dt>
                            <dd class="col-7 mb-0 text-break">
                                @conta.DataAbertura.ToString("dd/MM/yyyy")
                            </dd>

                            <dt class="col-5 text-secondary fw-semibold">
                                Situação
                            </dt>
                            <dd class="col-7 mb-0 text-break">
                                @conta.Situacao
                            </dd>

                        </dl>

                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">

                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                               asp-action="Pedido"
                               asp-route-id="@conta.Id">
                                Pedido
                            </a>

                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                               asp-action="Editar"
                               asp-route-id="@conta.Id">
                                Editar
                            </a>

                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                               asp-action="Excluir"
                               asp-route-id="@conta.Id">
                                Excluir
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}